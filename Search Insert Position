class Solution {

    public int searchInsert(int[] nums, int target) {

        for (int i = 0; i < nums.length; i++) {

            if (nums[i] >= target) {
                return i;
            }
        }

        return nums.length;
    }

    public static void main(String[] args) {

        Solution s = new Solution();

        int nums[] = {1,2,3,6};

        System.out.println(s.searchInsert(nums,5));
    }
}
